# Ignore dependencies and the local store
node_modules
.pnpm-store

# Ignore every dotenv file: the image is configured by the environment, never by a baked-in file
.env*

# Ignore logs and coverage
logs
coverage

# Ignore test files
tests
vitest*.config.mjs
sessions_test*

# Ignore session files
sessions

# Ignore git and tooling
.git
.gitignore
.github
.cursor
.claude
biome.json
scripts

# Ignore docs and build files
README.md
CONTRIBUTING.md
CLAUDE.md
LICENSE.md
Dockerfile
docker-compose.yml
assets
