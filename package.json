{
  "name": "whatsapp-web-api",
  "version": "1.1.0",
  "description": "REST API wrapper for whatsapp-web.js",
  "main": "server.js",
  "packageManager": "pnpm@11.14.0",
  "scripts": {
    "start": "node server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "swagger": "node swagger.js"
  },
  "dependencies": {
    "@julianobazzi/utils": "1.0.9",
    "axios": "1.18.1",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.6.0",
    "qr-image": "3.2.0",
    "qrcode-terminal": "0.12.0",
    "swagger-ui-express": "5.0.1",
    "whatsapp-web.js": "1.34.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@vitest/coverage-v8": "4.1.10",
    "supertest": "7.2.2",
    "swagger-autogen": "2.23.7",
    "vitest": "4.1.10"
  },
  "keywords": [
    "whatsapp",
    "whatsapp-web",
    "api",
    "wrapper",
    "rest",
    "express",
    "axios"
  ],
  "author": "Christophe Hubert",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JulianoBazzi/whatsapp-api.git"
  },
  "bugs": {
    "url": "https://github.com/JulianoBazzi/whatsapp-api/issues"
  },
  "homepage": "https://github.com/JulianoBazzi/whatsapp-api",
  "private": true
}
