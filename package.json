{
  "name": "whatsapp-web-api",
  "version": "1.2.3",
  "description": "REST API wrapper for whatsapp-web.js",
  "main": "server.js",
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "start": "node server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.mjs",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "swagger": "node swagger.js"
  },
  "dependencies": {
    "@julianobazzi/utils": "1.3.0",
    "axios": "1.21.1",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "express-rate-limit": "8.7.5",
    "pino": "10.4.0",
    "qr-image": "3.2.0",
    "qrcode-terminal": "0.12.0",
    "swagger-ui-express": "5.0.1",
    "whatsapp-web.js": "1.34.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@vitest/coverage-v8": "5.1.1",
    "supertest": "7.3.2",
    "swagger-autogen": "2.23.7",
    "vitest": "5.1.1"
  },
  "keywords": [
    "whatsapp",
    "whatsapp-web",
    "api",
    "wrapper",
    "rest",
    "express",
    "axios"
  ],
  "author": "Christophe Hubert",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JulianoBazzi/whatsapp-api.git"
  },
  "bugs": {
    "url": "https://github.com/JulianoBazzi/whatsapp-api/issues"
  },
  "homepage": "https://github.com/JulianoBazzi/whatsapp-api",
  "private": true
}
