{
  "name": "whatsapp-web-api",
  "version": "1.2.0",
  "description": "REST API wrapper for whatsapp-web.js",
  "main": "server.js",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "start": "node server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.mjs",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "swagger": "node swagger.js"
  },
  "dependencies": {
    "@julianobazzi/utils": "1.2.0",
    "axios": "1.20.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "pino": "10.3.1",
    "qr-image": "3.2.0",
    "qrcode-terminal": "0.12.0",
    "swagger-ui-express": "5.0.1",
    "whatsapp-web.js": "1.34.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@vitest/coverage-v8": "4.1.11",
    "supertest": "7.2.2",
    "swagger-autogen": "2.23.7",
    "vitest": "4.1.11"
  },
  "keywords": [
    "whatsapp",
    "whatsapp-web",
    "api",
    "wrapper",
    "rest",
    "express",
    "axios"
  ],
  "author": "Christophe Hubert",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JulianoBazzi/whatsapp-api.git"
  },
  "bugs": {
    "url": "https://github.com/JulianoBazzi/whatsapp-api/issues"
  },
  "homepage": "https://github.com/JulianoBazzi/whatsapp-api",
  "private": true
}
